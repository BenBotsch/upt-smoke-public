{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-bootstrap report 1.0",
  "description": "Machine-readable result of one project-bootstrap run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_version", "tool", "command", "mode", "target", "generated_at", "summary", "changes"],
  "properties": {
    "report_version": {"const": "1.0"},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "engineering-bootstrap"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "command": {"type": "string", "minLength": 1},
    "mode": {"enum": ["dry-run", "apply"]},
    "target": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "update", "delete", "noop", "skipped", "failed"],
      "properties": {
        "create": {"$ref": "#/$defs/count"},
        "update": {"$ref": "#/$defs/count"},
        "delete": {"$ref": "#/$defs/count"},
        "noop": {"$ref": "#/$defs/count"},
        "skipped": {"$ref": "#/$defs/count"},
        "failed": {"$ref": "#/$defs/count"}
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "key", "action", "reason", "details", "applied"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "key": {"type": "string", "minLength": 1},
          "action": {"enum": ["create", "update", "delete", "noop", "skipped", "failed"]},
          "reason": {"type": "string"},
          "details": {"type": "object"},
          "applied": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0}
  }
}
