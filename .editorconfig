# EditorConfig: https://editorconfig.org
# Shared formatting defaults for every language and platform.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,md,markdown}]
indent_size = 2

[*.py]
indent_size = 4

# Markdown uses two trailing spaces as a hard line break.
[*.{md,markdown}]
trim_trailing_whitespace = false

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

# Windows batch files require CRLF to run reliably in cmd.exe.
[*.{cmd,bat}]
end_of_line = crlf
