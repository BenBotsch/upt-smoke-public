# Normalize all text files to LF in the repository and in every checkout,
# so Windows, Linux and macOS see identical content.
* text=auto eol=lf

# Windows batch files need CRLF to run reliably in cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# PowerShell runs fine with LF; keep the default.

# Binary files: no diff, no line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.tar binary
*.jar binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Language statistics: documentation is not counted as code.
docs/** linguist-documentation
